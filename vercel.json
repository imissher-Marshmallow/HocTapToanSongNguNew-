{
  "version": 2,
  "name": "stem-project",
  "buildCommand": "cd stem-project && npm install && npm run build",
  "outputDirectory": "stem-project/build",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/(.*)",
      "destination": "/stem-project/build/index.html"
    }
  ]
}
