{
  "version": 2,
  "name": "stem-project",
  "buildCommand": "npm install && node copy-data.js && cd stem-project && npm install && cd backend && npm install && cd .. && npm run build",
  "outputDirectory": "stem-project/build",
  "functions": {
    "api/[...path].js": {
      "maxDuration": 30,
      "memory": 1024
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/[...path].js"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "env": {
    "NODE_ENV": "production"
  }
}

